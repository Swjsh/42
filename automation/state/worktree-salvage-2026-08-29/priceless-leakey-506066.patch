+# ---------- render_autopsy_lines: INCOMPLETE vs genuine-flat-day (2026-07-09 evening gap) -----
+# trade_autopsy.py's own render_md()/queue_ping() already distinguish "0 positions found" (a
+# real flat day) from "positions found but 0 replayable" (INCOMPLETE, e.g. bars unavailable --
+# see trade-autopsy-last.json's n_positions_found vs n_positions). firm_brief's one-liner is
+# the ONLY thing J actually reads day to day, so it must carry the same distinction -- an
+# INCOMPLETE run must never render identically to a quiet flat day (OP-33/C7).
+
+def test_incomplete_run_renders_distinct_line_not_flat_day():
+    autopsy = {"date": "2026-07-09", "n_positions_found": 10, "n_positions": 0,
+              "n_no_bars": 10, "net_pnl": 0.0, "n_stopped_then_paid": 0,
+              "new_hypotheses": [], "md": "analysis/autopsies/2026-07-09.md"}
+    lines = fb.render_autopsy_lines(autopsy, _et(2026, 7, 9, 17, 0))
+    text = "\n".join(lines)
+    assert "INCOMPLETE" in text
+    assert "10" in text
+    assert "not a flat day" in text.lower()
+    assert "0 engine positions" not in text
+    assert "analysis/autopsies/2026-07-09.md" in text
+
+
+def test_genuine_flat_day_still_renders_normally():
+    autopsy = {"date": "2026-07-09", "n_positions_found": 0, "n_positions": 0,
+              "n_no_bars": 0, "net_pnl": 0.0, "n_stopped_then_paid": 0,
+              "new_hypotheses": [], "md": "analysis/autopsies/2026-07-09.md"}
+    lines = fb.render_autopsy_lines(autopsy, _et(2026, 7, 9, 17, 0))
+    text = "\n".join(lines)
+    assert "INCOMPLETE" not in text
+    assert "0 engine positions" in text
+
+
+def test_normal_day_with_positions_unaffected():
+    autopsy = {"date": "2026-07-09", "n_positions_found": 3, "n_positions": 3,
+              "n_no_bars": 0, "net_pnl": 125.5, "n_stopped_then_paid": 1,
+              "new_hypotheses": ["H-2026-07-09-stop-noise"],
+              "md": "analysis/autopsies/2026-07-09.md"}
+    lines = fb.render_autopsy_lines(autopsy, _et(2026, 7, 9, 17, 0))
+    text = "\n".join(lines)
+    assert "INCOMPLETE" not in text
+    assert "3 engine positions" in text
+    assert "+$125.50" in text
+    assert "H-2026-07-09-stop-noise" in text
+
+
+def test_error_branch_takes_priority_over_incomplete_check():
+    # error must win even if n_positions_found/n_positions happen to also be present
+    autopsy = {"date": "2026-07-09", "error": "boom", "n_positions_found": 5, "n_positions": 0}
+    lines = fb.render_autopsy_lines(autopsy, _et(2026, 7, 9, 17, 0))
+    text = "\n".join(lines)
+    assert "FAILED" in text
+    assert "INCOMPLETE" not in text

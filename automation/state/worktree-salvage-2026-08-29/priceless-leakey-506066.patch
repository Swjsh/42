+def render_autopsy_lines(autopsy: dict, now_et) -> list[str]:
+    """PURE: render the trade-autopsy section body (Gamma_TradeAutopsy 16:15 ET --
+    the hypothesis organ J asked for 2026-07-08, "why doesn't Gamma think 'maybe
+    we're stopping out too early'") from its last-run snapshot
+    (automation/state/trade-autopsy-last.json). A MISSED FIRE is rendered LOUDLY
+    via autopsy_staleness_note (OP-33b: registered != firing). An INCOMPLETE run --
+    positions existed in the broker-truth ledger but none could be replayed, e.g.
+    bars data unavailable (trade_autopsy.py's render_md()/queue_ping() INCOMPLETE
+    branch, 2026-07-09 evening fix) -- gets its OWN distinct line and must never
+    fall through to the normal "N positions" line: n_positions==0 there is NOT a
+    flat day and must never read like one (OP-33/C7 silent-success-is-failure --
+    the exact failure mode the 07-09 fix closed on the .md side; this closes it
+    on the one-line brief J actually reads). Guard: test_firm_brief_autopsy_staleness.py."""
+    out = []
+    stale_note = autopsy_staleness_note(autopsy.get("date"), now_et)
+    if stale_note:
+        out.append(stale_note)
+    if not autopsy:
+        out.append("- no autopsy yet (Gamma_TradeAutopsy fires 16:15 ET).")
+    elif autopsy.get("error"):
+        out.append(f"- {autopsy.get('date', '?')}: autopsy FAILED ({autopsy['error'][:100]}) -- fix me.")
+    elif autopsy.get("n_positions_found", 0) > 0 and autopsy.get("n_positions", 0) == 0:
+        out.append(f"- {autopsy.get('date', '?')}: INCOMPLETE -- {autopsy.get('n_positions_found', 0)} "
+                   f"closed engine position(s) found in the broker-truth ledger but bars data was "
+                   f"unavailable for all {autopsy.get('n_no_bars', 0)} of them (NOT a flat day) "
+                   f"({autopsy.get('md', 'analysis/autopsies/')})")
+    else:
+        hyp = autopsy.get("new_hypotheses") or []
+        hyp_s = f"; NEW hypotheses: {', '.join(hyp)}" if hyp else "; no new hypotheses"
+        out.append(f"- {autopsy.get('date', '?')}: {autopsy.get('n_positions', 0)} engine positions, "
+                   f"net {_fmt_money(float(autopsy.get('net_pnl', 0)))}, "
+                   f"{autopsy.get('n_stopped_then_paid', 0)} stopped-then-paid{hyp_s} "
+                   f"({autopsy.get('md', 'analysis/autopsies/')})")
+    return out
+

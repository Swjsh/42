+def check_macro_calendar_freshness(now, calendar_path=None, params_path=None) -> list[str]:
+    """MACRO-CALENDAR STALENESS (content, not mtime). Root-caused 2026-07-06:
+    Gamma_WeeklyReview's Section 8a (Sunday 18:00 ET) is the ONLY writer of
+    macro-calendar.json#refresh_log[] -- premarket Step 1b derives today-bias.json's
+    calendar_freshness_days / catalyst_narrative / news_calendar.stale entirely from
+    that log's last timestamp (params.json#_calendar_freshness_section documents this
+    exact division of responsibility). Section 8a sat at ~90% of a long, 720s-timeout-
+    capped weekly-review prompt, so heavier earlier sections routinely starved it out --
+    refresh_log silently stopped growing after 2026-06-14 for 3+ consecutive Sundays
+    (06-21 produced a full analysis/2026-W25.md with no new refresh_log entry; 06-28
+    and 07-05 produced no analysis file at all) while calendar_freshness_days quietly
+    grew by 7 every unfixed Sunday. This check re-derives the SAME staleness signal
+    every ~30 min (this fire's cadence) instead of waiting for a human to notice the
+    number creeping in a once-a-day premarket journal entry. Section 8a's execution
+    was also moved earlier in weekly-review.md (Step 2a) so it survives the timeout
+    going forward -- this check is the loud backstop if it ever regresses. Fail-open."""
+    out: list[str] = []
+    p = calendar_path or (STATE / "macro-calendar.json")
+    pp = params_path or (STATE / "params.json")
+    try:
+        d = json.loads(p.read_text(encoding="utf-8"))
+    except Exception:  # noqa: BLE001
+        return out  # missing/unreadable -- not this check's job to invent a problem
+    log = d.get("refresh_log") or []
+    if not log:
+        out.append("MACRO-CALENDAR NEVER REFRESHED: refresh_log is empty -- Gamma_WeeklyReview Section 8a has never completed.")
+        return out
+    ts_raw = log[-1].get("ran_at") or log[-1].get("refreshed_at")
+    if not ts_raw:
+        return out
+    try:
+        last_dt = dt.datetime.fromisoformat(ts_raw)
+        if last_dt.tzinfo is not None:
+            # ts_raw carries an explicit ET offset (e.g. -04:00/-05:00) -- the wall-clock
+            # portion IS already ET local time (matches et_now()'s naive-ET convention),
+            # so drop tzinfo rather than convert.
+            last_dt = last_dt.replace(tzinfo=None)
+    except ValueError:
+        return out  # unparseable timestamp -- don't fabricate a problem
+    days_stale = (now - last_dt).total_seconds() / 86400.0
+    threshold = 7
+    try:
+        threshold = json.loads(pp.read_text(encoding="utf-8")).get("macro_calendar_max_staleness_days", 7)
+    except Exception:  # noqa: BLE001
+        pass
+    if days_stale > threshold:
+        out.append(f"MACRO-CALENDAR STALE: refresh_log last entry '{ts_raw}' is {days_stale:.0f}d old "
+                   f"(threshold {threshold}d) -- Gamma_WeeklyReview Section 8a has not completed for "
+                   f"{max(1, int(days_stale // 7))}+ Sunday(s). No-trade windows around FOMC/CPI/NFP may be "
+                   f"silently absent from today-bias.json. Run setup/scripts/run-weekly-review.ps1 manually "
+                   f"or wait for next Sunday fire.")
+    return out
+
